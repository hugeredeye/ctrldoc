# Copy to .env and provide values locally. Never commit the resulting file.
DATABASE_URL=
OBJECT_STORAGE_ROOT=
MAX_UPLOAD_BYTES=26214400
LOG_LEVEL=INFO

# Local-only explicit authentication bypass. Production must use AUTH_MODE=oidc and must never
# set DEV_AUTH_ENABLED=true.
ENVIRONMENT=development
AUTH_MODE=dev
DEV_AUTH_ENABLED=true
PROVISIONING_PRINCIPALS=["urn:ctrl-v2:development|operator"]

# Production OIDC trust inputs (uncomment and provide through the production secret/config
# injector). Configure exactly one of OIDC_JWKS_URL or OIDC_JWKS_JSON.
# OIDC_ISSUER=https://identity.example.com/
# OIDC_AUDIENCE=ctrl-v2
# OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# OIDC_JWKS_JSON={"keys":[...]}
# OIDC_ALLOWED_ALGORITHMS=["RS256"]
# OIDC_PRINCIPAL_TYPE_CLAIM=principal_type

# API processes use DATABASE_URL with ctrl_v2_runtime. Migration processes use
# DATABASE_URL with ctrl_v2_migrator. Never expose the migrator URL to the API.

# Docker Compose bootstrap. Supply real values only in an uncommitted .env.
POSTGRES_ADMIN_USER=ctrl_v2_admin
POSTGRES_ADMIN_PASSWORD=
POSTGRES_MIGRATOR_PASSWORD=
POSTGRES_RUNTIME_PASSWORD=
POSTGRES_DB=ctrl_v2
POSTGRES_PORT=5432
