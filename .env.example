# Copy to .env and provide values locally. Never commit the resulting file.
DATABASE_URL=
OBJECT_STORAGE_ROOT=
MAX_UPLOAD_BYTES=26214400
LOG_LEVEL=INFO

# API processes use DATABASE_URL with ctrl_v2_runtime. Migration processes use
# DATABASE_URL with ctrl_v2_migrator. Never expose the migrator URL to the API.

# Docker Compose bootstrap. Supply real values only in an uncommitted .env.
POSTGRES_ADMIN_USER=ctrl_v2_admin
POSTGRES_ADMIN_PASSWORD=
POSTGRES_MIGRATOR_PASSWORD=
POSTGRES_RUNTIME_PASSWORD=
POSTGRES_DB=ctrl_v2
POSTGRES_PORT=5432
