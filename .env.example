# Copy to .env and provide values locally. Never commit the resulting file.
DATABASE_URL=
OBJECT_STORAGE_ROOT=
MAX_UPLOAD_BYTES=26214400
LOG_LEVEL=INFO

# Docker Compose bootstrap. Supply real values only in an uncommitted .env.
POSTGRES_ADMIN_USER=ctrl_v2_admin
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_USER=ctrl_v2_app
POSTGRES_APP_PASSWORD=
POSTGRES_DB=ctrl_v2
POSTGRES_PORT=5432
