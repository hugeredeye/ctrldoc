{
  "$defs": {
    "AnnotationReviewStatus": {
      "enum": [
        "DRAFT",
        "REVIEWED",
        "ADJUDICATED",
        "FROZEN"
      ],
      "title": "AnnotationReviewStatus",
      "type": "string"
    },
    "BenchmarkSourceCategory": {
      "enum": [
        "PRODUCT_DOCUMENTATION",
        "CERTIFICATION_OR_TEST",
        "RELEASE_OR_ROADMAP",
        "RFP_OR_TENDER",
        "PREVIOUS_APPROVED_RESPONSE",
        "INTERNAL_KNOWLEDGE",
        "OTHER"
      ],
      "title": "BenchmarkSourceCategory",
      "type": "string"
    },
    "DatasetScope": {
      "enum": [
        "CHECKED_IN_TEST",
        "EXTERNAL_RESTRICTED"
      ],
      "title": "DatasetScope",
      "type": "string"
    },
    "DocxLocator": {
      "additionalProperties": false,
      "properties": {
        "column_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column Index"
        },
        "kind": {
          "const": "DOCX",
          "default": "DOCX",
          "title": "Kind",
          "type": "string"
        },
        "paragraph_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph Index"
        },
        "row_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Index"
        },
        "section_path": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Section Path",
          "type": "array"
        },
        "table_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Index"
        }
      },
      "title": "DocxLocator",
      "type": "object"
    },
    "EvidenceAuthorityLevel": {
      "enum": [
        "AUTHORITATIVE",
        "STRONG",
        "SUPPORTING",
        "WEAK",
        "UNVERIFIED"
      ],
      "title": "EvidenceAuthorityLevel",
      "type": "string"
    },
    "EvidenceSourceType": {
      "enum": [
        "OFFICIAL_SPECIFICATION",
        "CERTIFICATION",
        "TEST_REPORT",
        "RELEASE_NOTES",
        "ROADMAP",
        "PREVIOUS_APPROVED_RESPONSE",
        "INTERNAL_NOTE",
        "OTHER"
      ],
      "title": "EvidenceSourceType",
      "type": "string"
    },
    "GoldAnnotation": {
      "additionalProperties": false,
      "properties": {
        "annotated_at": {
          "format": "date-time",
          "title": "Annotated At",
          "type": "string"
        },
        "annotation_version": {
          "minLength": 1,
          "title": "Annotation Version",
          "type": "string"
        },
        "annotator": {
          "minLength": 1,
          "title": "Annotator",
          "type": "string"
        }
      },
      "required": [
        "annotator",
        "annotation_version",
        "annotated_at"
      ],
      "title": "GoldAnnotation",
      "type": "object"
    },
    "GoldAtomicRequirement": {
      "additionalProperties": false,
      "properties": {
        "atomic_text": {
          "minLength": 1,
          "title": "Atomic Text",
          "type": "string"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequirementLanguage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "modality": {
          "minLength": 1,
          "title": "Modality",
          "type": "string"
        },
        "source_end_offset": {
          "exclusiveMinimum": 0,
          "title": "Source End Offset",
          "type": "integer"
        },
        "source_quote": {
          "minLength": 1,
          "title": "Source Quote",
          "type": "string"
        },
        "source_start_offset": {
          "minimum": 0,
          "title": "Source Start Offset",
          "type": "integer"
        }
      },
      "required": [
        "key",
        "atomic_text",
        "source_quote",
        "source_start_offset",
        "source_end_offset",
        "modality"
      ],
      "title": "GoldAtomicRequirement",
      "type": "object"
    },
    "GoldBenchmarkCaseMetadata": {
      "additionalProperties": false,
      "properties": {
        "grouping": {
          "$ref": "#/$defs/GoldBenchmarkGrouping"
        },
        "review": {
          "$ref": "#/$defs/GoldIndependentReview"
        },
        "source_category": {
          "$ref": "#/$defs/BenchmarkSourceCategory"
        }
      },
      "required": [
        "source_category",
        "grouping"
      ],
      "title": "GoldBenchmarkCaseMetadata",
      "type": "object"
    },
    "GoldBenchmarkGrouping": {
      "additionalProperties": false,
      "properties": {
        "document_family": {
          "minLength": 1,
          "title": "Document Family",
          "type": "string"
        },
        "product_family": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Family"
        },
        "product_version_family": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Version Family"
        },
        "source_case_family": {
          "minLength": 1,
          "title": "Source Case Family",
          "type": "string"
        }
      },
      "required": [
        "document_family",
        "source_case_family"
      ],
      "title": "GoldBenchmarkGrouping",
      "type": "object"
    },
    "GoldCase": {
      "additionalProperties": false,
      "properties": {
        "annotation": {
          "$ref": "#/$defs/GoldAnnotation"
        },
        "benchmark": {
          "anyOf": [
            {
              "$ref": "#/$defs/GoldBenchmarkCaseMetadata"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "case_id": {
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9._-]+$",
          "title": "Case Id",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "gold_atomic_requirements": {
          "items": {
            "$ref": "#/$defs/GoldAtomicRequirement"
          },
          "minItems": 1,
          "title": "Gold Atomic Requirements",
          "type": "array"
        },
        "gold_compliance_outcomes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/GoldComplianceOutcome"
          },
          "title": "Gold Compliance Outcomes",
          "type": "array"
        },
        "gold_evidence_spans": {
          "items": {
            "$ref": "#/$defs/GoldEvidenceSpan"
          },
          "title": "Gold Evidence Spans",
          "type": "array"
        },
        "gold_mappings": {
          "items": {
            "$ref": "#/$defs/GoldMapping"
          },
          "title": "Gold Mappings",
          "type": "array"
        },
        "hard_negative_evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/GoldHardNegativeEvidence"
          },
          "title": "Hard Negative Evidence",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/GoldProvenance"
        },
        "source_requirement": {
          "$ref": "#/$defs/GoldSourceRequirement"
        }
      },
      "required": [
        "case_id",
        "description",
        "source_requirement",
        "annotation",
        "provenance",
        "gold_atomic_requirements",
        "gold_mappings",
        "gold_evidence_spans"
      ],
      "title": "GoldCase",
      "type": "object"
    },
    "GoldComplianceLabel": {
      "enum": [
        "COMPLY",
        "PARTIAL",
        "GAP",
        "UNKNOWN",
        "NEEDS_CLARIFICATION"
      ],
      "title": "GoldComplianceLabel",
      "type": "string"
    },
    "GoldComplianceOutcome": {
      "additionalProperties": false,
      "properties": {
        "assessment_as_of": {
          "format": "date",
          "title": "Assessment As Of",
          "type": "string"
        },
        "atomic_requirement_key": {
          "title": "Atomic Requirement Key",
          "type": "string"
        },
        "critical": {
          "default": false,
          "title": "Critical",
          "type": "boolean"
        },
        "outcome": {
          "$ref": "#/$defs/GoldComplianceLabel"
        },
        "product_version_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Version Key"
        }
      },
      "required": [
        "atomic_requirement_key",
        "assessment_as_of",
        "outcome"
      ],
      "title": "GoldComplianceOutcome",
      "type": "object"
    },
    "GoldEvidenceSpan": {
      "additionalProperties": false,
      "properties": {
        "asset_path": {
          "minLength": 1,
          "title": "Asset Path",
          "type": "string"
        },
        "atomic_requirement_key": {
          "title": "Atomic Requirement Key",
          "type": "string"
        },
        "authority_level": {
          "$ref": "#/$defs/EvidenceAuthorityLevel"
        },
        "document_key": {
          "minLength": 1,
          "title": "Document Key",
          "type": "string"
        },
        "document_version": {
          "minLength": 1,
          "title": "Document Version",
          "type": "string"
        },
        "exact_quote": {
          "minLength": 1,
          "title": "Exact Quote",
          "type": "string"
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "locator": {
          "discriminator": {
            "mapping": {
              "DOCX": "#/$defs/DocxLocator",
              "PDF": "#/$defs/PdfLocator",
              "XLSX": "#/$defs/XlsxLocator"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PdfLocator"
            },
            {
              "$ref": "#/$defs/DocxLocator"
            },
            {
              "$ref": "#/$defs/XlsxLocator"
            }
          ],
          "title": "Locator"
        },
        "product_version_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Version Key"
        },
        "source_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sha256"
        },
        "source_type": {
          "$ref": "#/$defs/EvidenceSourceType"
        },
        "valid_from": {
          "format": "date",
          "title": "Valid From",
          "type": "string"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        }
      },
      "required": [
        "atomic_requirement_key",
        "asset_path",
        "document_key",
        "document_version",
        "source_type",
        "authority_level",
        "valid_from",
        "exact_quote",
        "locator"
      ],
      "title": "GoldEvidenceSpan",
      "type": "object"
    },
    "GoldHardNegativeEvidence": {
      "additionalProperties": false,
      "properties": {
        "asset_path": {
          "minLength": 1,
          "title": "Asset Path",
          "type": "string"
        },
        "atomic_requirement_key": {
          "title": "Atomic Requirement Key",
          "type": "string"
        },
        "authority_level": {
          "$ref": "#/$defs/EvidenceAuthorityLevel"
        },
        "document_key": {
          "minLength": 1,
          "title": "Document Key",
          "type": "string"
        },
        "document_version": {
          "minLength": 1,
          "title": "Document Version",
          "type": "string"
        },
        "error_tags": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HardNegativeErrorTag"
          },
          "title": "Error Tags",
          "type": "array"
        },
        "exact_quote": {
          "minLength": 1,
          "title": "Exact Quote",
          "type": "string"
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "locator": {
          "discriminator": {
            "mapping": {
              "DOCX": "#/$defs/DocxLocator",
              "PDF": "#/$defs/PdfLocator",
              "XLSX": "#/$defs/XlsxLocator"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PdfLocator"
            },
            {
              "$ref": "#/$defs/DocxLocator"
            },
            {
              "$ref": "#/$defs/XlsxLocator"
            }
          ],
          "title": "Locator"
        },
        "product_version_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Version Key"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "source_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sha256"
        },
        "source_type": {
          "$ref": "#/$defs/EvidenceSourceType"
        },
        "valid_from": {
          "format": "date",
          "title": "Valid From",
          "type": "string"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        }
      },
      "required": [
        "atomic_requirement_key",
        "asset_path",
        "document_key",
        "document_version",
        "source_type",
        "authority_level",
        "valid_from",
        "exact_quote",
        "locator",
        "reason"
      ],
      "title": "GoldHardNegativeEvidence",
      "type": "object"
    },
    "GoldIndependentReview": {
      "additionalProperties": false,
      "properties": {
        "adjudicated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjudicated At"
        },
        "adjudication_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjudication Note"
        },
        "adjudicator_alias": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjudicator Alias"
        },
        "disagreement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disagreement"
        },
        "frozen_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frozen At"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "reviewer_alias": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer Alias"
        },
        "status": {
          "$ref": "#/$defs/AnnotationReviewStatus",
          "default": "DRAFT"
        }
      },
      "title": "GoldIndependentReview",
      "type": "object"
    },
    "GoldMapping": {
      "additionalProperties": false,
      "properties": {
        "atomic_requirement_key": {
          "title": "Atomic Requirement Key",
          "type": "string"
        },
        "capability_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability Key"
        },
        "product_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Key"
        },
        "product_version_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Version Key"
        }
      },
      "required": [
        "atomic_requirement_key"
      ],
      "title": "GoldMapping",
      "type": "object"
    },
    "GoldProvenance": {
      "additionalProperties": false,
      "properties": {
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "source_collection": {
          "minLength": 1,
          "title": "Source Collection",
          "type": "string"
        },
        "source_revision": {
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "source_collection",
        "source_revision"
      ],
      "title": "GoldProvenance",
      "type": "object"
    },
    "GoldSourceRequirement": {
      "additionalProperties": false,
      "properties": {
        "asset_path": {
          "description": "Dataset-relative source document path",
          "minLength": 1,
          "title": "Asset Path",
          "type": "string"
        },
        "context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context"
        },
        "locator": {
          "discriminator": {
            "mapping": {
              "DOCX": "#/$defs/DocxLocator",
              "PDF": "#/$defs/PdfLocator",
              "XLSX": "#/$defs/XlsxLocator"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PdfLocator"
            },
            {
              "$ref": "#/$defs/DocxLocator"
            },
            {
              "$ref": "#/$defs/XlsxLocator"
            }
          ],
          "title": "Locator"
        },
        "source_text": {
          "minLength": 1,
          "title": "Source Text",
          "type": "string"
        }
      },
      "required": [
        "asset_path",
        "source_text",
        "locator"
      ],
      "title": "GoldSourceRequirement",
      "type": "object"
    },
    "HardNegativeErrorTag": {
      "enum": [
        "WRONG_PRODUCT_VERSION",
        "OBSOLETE_SOURCE",
        "ROADMAP_NOT_RELEASED",
        "NON_ENTAILING",
        "CONFLICTING_EVIDENCE",
        "TEMPORAL_VALIDITY",
        "SOURCE_AUTHORITY",
        "RELATED_FEATURE_MISSING_CAPABILITY",
        "SAME_TERMINOLOGY_DIFFERENT_SEMANTICS",
        "INSUFFICIENT_QUANTITATIVE_LIMIT",
        "LOWER_AUTHORITY_CONTRADICTION",
        "PARTIAL_COMPOUND_EVIDENCE",
        "PREVIOUS_RESPONSE_UNVERIFIED"
      ],
      "title": "HardNegativeErrorTag",
      "type": "string"
    },
    "PdfLocator": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "kind": {
          "const": "PDF",
          "default": "PDF",
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        }
      },
      "required": [
        "page"
      ],
      "title": "PdfLocator",
      "type": "object"
    },
    "RequirementLanguage": {
      "enum": [
        "RU",
        "EN",
        "MIXED",
        "OTHER"
      ],
      "title": "RequirementLanguage",
      "type": "string"
    },
    "XlsxLocator": {
      "additionalProperties": false,
      "properties": {
        "cell_range": {
          "title": "Cell Range",
          "type": "string"
        },
        "kind": {
          "const": "XLSX",
          "default": "XLSX",
          "title": "Kind",
          "type": "string"
        },
        "sheet": {
          "title": "Sheet",
          "type": "string"
        },
        "table_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Name"
        }
      },
      "required": [
        "sheet",
        "cell_range"
      ],
      "title": "XlsxLocator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cases": {
      "default": [],
      "items": {
        "$ref": "#/$defs/GoldCase"
      },
      "title": "Cases",
      "type": "array"
    },
    "contains_customer_data": {
      "title": "Contains Customer Data",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
